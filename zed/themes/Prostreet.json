        "title_bar.background": "#1d1f21ff",
        "title_bar.inactive_background": "#161819ff",
        "status_bar.background": "#1d1f21ff",
        "toolbar.background": "#161819ff",
        "tab_bar.background": "#1d1f21ff",
        "tab.inactive_background": "#1d1f21ff",
        "tab.active_background": "#161819ff",
        "border": "#383c3fff",
        "border.variant": "#2a2d2fff",
        "border.focused": "#b8f02cff",
        "border.selected": "#b8f02cff",
        "panel.focused_border": "#b8f02cff",
        "pane.focused_border": "#b8f02cff",
        "element.background": "#1d1f21ff",
        "element.hover": "#25282aff",
        "element.active": "#30353aff",
        "element.selected": "#30353aff",
        "text": "#d9dbd6ff",
        "text.muted": "#92989bff",
        "text.placeholder": "#70767aff",
        "text.disabled": "#4a4f52ff",
        "text.accent": "#7fb1c4ff",
        "icon": "#d9dbd6ff",
        "icon.muted": "#92989bff",
        "icon.disabled": "#4a4f52ff",
        "icon.accent": "#7fb1c4ff",
        "editor.background": "#161819ff",
        "editor.foreground": "#d9dbd6ff",
        "editor.gutter.background": "#161819ff",
        "editor.line_number": "#4a4f52ff",
        "editor.active_line_number": "#b8f02cff",
        "editor.active_line.background": "#1b1d1fff",
        "editor.highlighted_line.background": "#1b1d1fff",
        "editor.indent_guide": "#2a2d2fff",
        "editor.indent_guide_active": "#4a4f52ff",
        "editor.invisible": "#4a4f52ff",
        "editor.selection.background": "#30353aff",
        "search.match_background": "#4a5a1a99",
        "search.active_match_background": "#8fb339bb",
        "cursor": "#b8f02cff",
