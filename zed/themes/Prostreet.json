          "function.builtin": { "color": "#7fb1c4ff" },
          "function.method": { "color": "#7fb1c4ff" },
          "hint": { "color": "#92989bff" },
          "keyword": { "color": "#b8f02cff" },
          "label": { "color": "#b8f02cff" },
