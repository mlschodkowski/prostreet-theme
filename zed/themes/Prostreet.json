          "constant": { "color": "#a6c8d6ff" },
          "constant.builtin": { "color": "#a6c8d6ff" },
          "constructor": { "color": "#f4f5f0ff" },
          "embedded": { "color": "#d9dbd6ff" },
          "emphasis": { "color": "#d9dbd6ff" },
