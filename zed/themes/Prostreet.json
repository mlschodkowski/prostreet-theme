          "number": { "color": "#a6c8d6ff" },
          "operator": { "color": "#92989bff" },
          "predictive": { "color": "#70767aff" },
          "preproc": { "color": "#aab0b3ff" },
          "primary": { "color": "#d9dbd6ff" },
          "property": { "color": "#d9dbd6ff" },
          "punctuation": { "color": "#92989bff" },
          "punctuation.bracket": { "color": "#92989bff" },
          "punctuation.delimiter": { "color": "#92989bff" },
