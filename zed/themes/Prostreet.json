          "type": { "color": "#f4f5f0ff" },
          "type.builtin": { "color": "#f4f5f0ff" },
          "variable": { "color": "#d9dbd6ff" },
          "variable.special": { "color": "#aab0b3ff" },
          "variant": { "color": "#f4f5f0ff" }
        },
        "players": [
          {
            "cursor": "#b8f02cff",
            "background": "#b8f02cff",
            "selection": "#30353aff"
          }
        ]
